# Copy to .env and fill in. Without PayPal keys the app runs in mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Your US sandbox *personal* account email. The first payment of each batch goes here,
# so you can log in to sandbox.paypal.com and see the money arrive.
DEMO_RECEIVER_EMAIL=
# How many payments per batch to actually send in sandbox (the rest stay eligible)
DEMO_PAYOUT_LIMIT=5

# AI second opinions and claimant letters. Set any of these keys; they are tried in AI_ORDER.
# If one is out of quota or down, the next answers. Without any key, rule-based text is used.
AI_ORDER=gemini,groq,openrouter,anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=15000

# Optional: real "Log in with PayPal" (enable it in your sandbox app and add the return URL
# PUBLIC_URL/auth/paypal/callback). Set to 1 to use it; otherwise a mock sign-in is used.
LOGIN_WITH_PAYPAL=0
PUBLIC_URL=http://localhost:3000
PORT=3000
